# Copy to .env for local use. Never commit the real values.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_flash_lite_model_name_here

# Everything below is optional -- sensible defaults are baked in (see the
# comments next to each one in backend/app/main.py, tools.py and agent.py).
# Uncomment and tune before deploying.

# Comma-separated real frontend origin(s), e.g. https://pitwall.vercel.app.
# Unset = localhost dev origins only. Set this for the real deployment.
# ALLOWED_ORIGINS=

# In-memory daily cap on /api/chat calls, so the demo fails friendly before
# Google's own free-tier quota does. Default 150 is a placeholder -- tune it
# once you know your GEMINI_MODEL's actual free-tier daily request limit.
# DAILY_REQUEST_CAP=150

# Max tool-calling rounds within a single reply (default 6).
# MAX_TOOL_CALLS_PER_MESSAGE=6

# Max FastF1 race sessions kept in memory at once (default 2; see the
# memory measurement in tools.py for why 2 is safe on Render's free tier).
# SESSION_CACHE_SIZE=2

# Where FastF1's cache and saved plots live, relative to the working
# directory the server is started from (default f1_cache / plots).
# FASTF1_CACHE_DIR=f1_cache
# PLOT_DIR=plots
