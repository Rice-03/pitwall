# Copy to .env.local for local development.
# Must match the port the backend is actually running on. 8000 is the
# default in the docs, but if something else already owns it (check with
# `netstat -ano | findstr :8000`), start the backend on another port, e.g.
# `uvicorn app.main:app --port 8001`, and set this to match.
NEXT_PUBLIC_API_URL=http://localhost:8000
